generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Auth tables (better-auth). Column names stay camelCase to match better-auth's
// vendor schema 1:1 — its docs and migrations assume those names, and remapping
// every field would create an ongoing maintenance tax. Our additions
// (`entityId`, `firstname`, `lastname`) follow the same convention for
// consistency within these tables.

model User {
  id            String   @id
  entityId      String   @unique
  requestId     String?
  firstname     String
  lastname      String
  name          String?
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  staffRole     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions             Session[]
  accounts             Account[]
  memberships          Membership[]
  sentInvitations      Invitation[] @relation("InvitationInvitedBy")
  acceptedInvitations  Invitation[] @relation("InvitationAcceptedBy")

  @@index([requestId])
  @@map("user")
}

model Session {
  id        String   @id
  entityId  String   @unique
  requestId String?
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("session")
}

model Account {
  id                    String    @id
  entityId              String    @unique
  requestId             String?
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("account")
}

model Verification {
  id         String   @id
  entityId   String   @unique
  requestId  String?
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([requestId])
  @@map("verification")
}

// First table we own (not vendor-managed). Snake_case columns via @map per
// the database skill; entityId is the primary key (no separate vendor `id`).
// Append-only by code discipline — nothing in our codebase calls update or
// delete against this model. See `audit` skill for the action union and
// usage rules.
model AuditLog {
  entityId            String   @id @map("entity_id")
  requestId           String?  @map("request_id")
  createdAt           DateTime @default(now()) @map("created_at")
  action              String
  actorUserId         String?  @map("actor_user_id")
  actorImpersonatorId String?  @map("actor_impersonator_id")
  resourceType        String?  @map("resource_type")
  resourceId          String?  @map("resource_id")
  ipAddress           String?  @map("ip_address")
  userAgent           String?  @map("user_agent")
  details             Json

  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@index([action, createdAt])
  @@index([requestId])
  @@map("audit_log")
}

// Tenancy primitives: orgs, the M:N join carrying role, and email invites.
// Snake_case columns via @map per the database skill; entityId is the PK
// (no separate vendor `id`). Cascade-on-org-delete wired today; once
// soft-delete lands those cascades still apply at hard-delete time.
model Organisation {
  entityId         String   @id @map("entity_id")
  requestId        String?  @map("request_id")
  name             String
  // Set the first time a Checkout session completes for the org. Stripe
  // creates the customer during Checkout; we capture it from the
  // `checkout.session.completed` webhook. Unique so the same customer
  // can't be linked to two orgs.
  stripeCustomerId String?  @unique @map("stripe_customer_id")
  createdAt        DateTime @default(now()) @map("created_at")

  memberships  Membership[]
  invitations  Invitation[]
  subscription Subscription?

  @@index([requestId])
  @@map("organisation")
}

model Membership {
  entityId       String   @id @map("entity_id")
  requestId      String?  @map("request_id")
  organisationId String   @map("organisation_id")
  userId         String   @map("user_id")
  role           String
  createdAt      DateTime @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [organisationId], references: [entityId], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organisationId, userId])
  @@index([userId])
  @@index([organisationId, role])
  @@index([requestId])
  @@map("membership")
}

// Outstanding-invite uniqueness ((organisation_id, email) WHERE not yet
// accepted/revoked) is enforced via a partial unique index added by hand in
// the migration SQL — Prisma's schema language can't express partial
// uniqueness yet. Service layer pre-checks for friendlier 409s.
model Invitation {
  entityId         String    @id @map("entity_id")
  requestId        String?   @map("request_id")
  organisationId   String    @map("organisation_id")
  email            String
  role             String
  tokenHash        String    @map("token_hash")
  invitedByUserId  String    @map("invited_by_user_id")
  acceptedAt       DateTime? @map("accepted_at")
  acceptedByUserId String?   @map("accepted_by_user_id")
  revokedAt        DateTime? @map("revoked_at")
  expiresAt        DateTime  @map("expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [organisationId], references: [entityId], onDelete: Cascade)
  invitedBy    User         @relation("InvitationInvitedBy", fields: [invitedByUserId], references: [id])
  acceptedBy   User?        @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id])

  @@index([tokenHash])
  @@index([email])
  @@index([requestId])
  @@map("invitation")
}

// Transactional outbox. Producers call `events.emit(event, { tx })` inside a
// Prisma transaction; the emit writes a row here in the same transaction so
// the intent commits atomically with the business write. After commit, the
// `outbox-drain` BullMQ repeatable job pulls unprocessed rows and enqueues
// each to its target queue. Eliminates the dual-write hole between Postgres
// and Redis. Idempotency: drainer marks `processed_at` only after a successful
// enqueue; downstream handlers should also be idempotent on `jobId`.
model Outbox {
  entityId    String    @id @map("entity_id")
  requestId   String?   @map("request_id")
  topic       String
  payload     Json
  targetQueue String    @map("target_queue")
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")

  @@index([processedAt, createdAt])
  @@index([requestId])
  @@map("outbox")
}

// One row per attempted email send. Worker handlers upsert by `dedupe_key`
// before calling the transport, then update status after the transport call
// returns. Re-runs of the same logical send (e.g. BullMQ retry after a
// successful SES call but before the worker marked the job done) find
// `sent_at` already set and no-op — preventing duplicate sends in normal
// failure modes. Also the source of truth for the `apps/internal` /emails
// view; bounce / complaint state columns land with the follow-up bounce
// handling PR.
model SentEmail {
  entityId   String    @id @map("entity_id")
  requestId  String?   @map("request_id")
  dedupeKey  String    @unique @map("dedupe_key")
  recipient  String
  template   String
  subject    String
  html       String
  text       String?
  status     String
  lastError  String?   @map("last_error")
  messageId  String?   @map("message_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  sentAt     DateTime? @map("sent_at")

  @@index([createdAt(sort: Desc)])
  @@index([recipient, createdAt(sort: Desc)])
  @@index([requestId])
  @@map("sent_emails")
}

// Stripe subscription mirror — one row per organisation, UPSERTed by
// the `customer.subscription.*` webhook handlers. The MVP doesn't keep
// historical rows (re-subscribing after cancel rotates
// `stripeSubscriptionId` on the same row); invoice history graduates
// into its own table when the internal-app surfaces it. `status` carries
// the Stripe enum — `active`, `trialing`, `past_due`, `canceled`,
// `incomplete`, `incomplete_expired`, `unpaid`. `getOrgAccessState`
// reads this row to decide paid / past_due / paywalled.
model Subscription {
  entityId             String    @id @map("entity_id")
  organisationId       String    @unique @map("organisation_id")
  stripeSubscriptionId String    @unique @map("stripe_subscription_id")
  stripeCustomerId     String    @map("stripe_customer_id")
  stripePriceId        String    @map("stripe_price_id")
  planKey              String    @map("plan_key")
  status               String
  currentPeriodStart   DateTime  @map("current_period_start")
  currentPeriodEnd     DateTime  @map("current_period_end")
  cancelAtPeriodEnd    Boolean   @default(false) @map("cancel_at_period_end")
  canceledAt           DateTime? @map("canceled_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  requestId            String?   @map("request_id")

  organisation Organisation @relation(fields: [organisationId], references: [entityId], onDelete: Cascade)

  @@index([stripeCustomerId])
  @@index([status])
  @@map("subscription")
}

// Idempotency anchor for the Stripe webhook. Insert before processing;
// uniqueness on `id` short-circuits replays. Payload deliberately not
// stored — Stripe's dashboard is the authoritative archive and storing
// it just bloats rows.
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([type, processedAt(sort: Desc)])
  @@map("stripe_event")
}
