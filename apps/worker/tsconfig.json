{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    // Worker doesn't render JSX itself, but it imports @template/emails
    // which has .tsx files. Setting jsx here lets tsc parse those files
    // for type resolution. `react-jsx` matches packages/emails internally.
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
