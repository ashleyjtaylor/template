{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    // Worker doesn't render JSX itself, but it imports @template/email
    // which has .tsx files under src/templates/. Setting jsx here lets
    // tsc parse those files for type resolution.
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
