# Copy to .env (gitignored) for local development.
# Production values are injected by ECS from Secrets Manager — see
# infra/cdk/lib/data-stack.ts and infra/cdk/lib/app-stack.ts.

NODE_ENV=development
APP_ENV=local
LOG_LEVEL=info

# Redis — used by BullMQ. Local dev defaults to no AUTH + no TLS; deployed
# envs override with REDIS_HOST + REDIS_PORT + REDIS_AUTH_TOKEN from Secrets
# Manager and @template/events composes a rediss:// URL with TLS.
REDIS_URL=redis://localhost:6379

# DB connection — defaults inside @template/db match docker-compose.yml.
# Override DB_HOST/PORT/USER/PASSWORD/NAME here for a non-default local DB.

# Email — local uses Mailpit (no AUTH, plaintext SMTP on :1025). Deployed
# envs use SES via @template/email's SesSender when EMAIL_FROM is set;
# otherwise the LogOnlySender writes sends to the worker log. See
# packages/email/src/transport-selector.ts.
EMAIL_FROM=noreply@local.test

# Customer-facing SPA base URL. The invitation handler builds the
# accept-invite URL relative to this. Local default matches apps/web's
# vite dev port. CDK injects the WebSpaUrl on staging/prod.
WEB_BASE_URL=http://localhost:5174
