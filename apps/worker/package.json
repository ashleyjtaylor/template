{
  "name": "@template/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@template/db": "workspace:*",
    "@template/email": "workspace:*",
    "@template/errors": "workspace:*",
    "@template/events": "workspace:*",
    "bullmq": "5.76.7",
    "ioredis": "5.10.1",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.12.3",
    "pino-pretty": "13.1.3",
    "tsc-alias": "1.8.17",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  }
}
