generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Lighthouse table — exists so /health/ready can prove both that the DB is
// reachable AND that migrations have applied. No business meaning.
model Meta {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")

  @@map("_meta")
}
