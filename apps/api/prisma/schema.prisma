generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Auth tables (better-auth). Column names stay camelCase to match better-auth's
// vendor schema 1:1 — its docs and migrations assume those names, and remapping
// every field would create an ongoing maintenance tax. Our additions
// (`entityId`, `firstname`, `lastname`) follow the same convention for
// consistency within these tables.

model User {
  id            String   @id
  entityId      String   @unique
  requestId     String?
  firstname     String
  lastname      String
  name          String?
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  staffRole     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  @@index([requestId])
  @@map("user")
}

model Session {
  id        String   @id
  entityId  String   @unique
  requestId String?
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("session")
}

model Account {
  id                    String    @id
  entityId              String    @unique
  requestId             String?
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("account")
}

model Verification {
  id         String   @id
  entityId   String   @unique
  requestId  String?
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([requestId])
  @@map("verification")
}

// First table we own (not vendor-managed). Snake_case columns via @map per
// the database skill; entityId is the primary key (no separate vendor `id`).
// Append-only by code discipline — nothing in our codebase calls update or
// delete against this model. See `audit` skill for the action union and
// usage rules.
model AuditLog {
  entityId            String   @id @map("entity_id")
  requestId           String?  @map("request_id")
  createdAt           DateTime @default(now()) @map("created_at")
  action              String
  actorUserId         String?  @map("actor_user_id")
  actorImpersonatorId String?  @map("actor_impersonator_id")
  resourceType        String?  @map("resource_type")
  resourceId          String?  @map("resource_id")
  ipAddress           String?  @map("ip_address")
  userAgent           String?  @map("user_agent")
  details             Json

  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@index([action, createdAt])
  @@index([requestId])
  @@map("audit_log")
}
